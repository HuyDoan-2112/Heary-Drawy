# Heary Drawy local development placeholder.
# Do not put real provider keys or child data in this file.

# Set DATABASE_URL in the shell before running dev:api, db:migrate or db:provision-room.
# Do not commit a real connection string. dev:api:local manages its own local Postgres.
# DATABASE_URL=postgresql://<operator-managed connection string>
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI feedback for `npm run demo` (step D2). Copy this file to .env (git-ignored) and paste your key there.
# Without it, rounds show the neutral result. Only drawings and transcripts are sent, never audio.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# WHISPER_MODEL=small.en
